{
  "groq_api_keys": [
    "",
    "",
    "",
    "",
    ""
  ],
  "model": "llama-3.3-70b-versatile",

  "security": {
    "level": "standard",
    "pin": "",
    "confirmation_mode": "smart",
    "max_failed_attempts": 5,
    "lockout_minutes": 15
  },

  "voice": {
    "wake_word_enabled": true,
    "wake_word": "игрис",
    "tts_voice": "ru-RU-DmitryNeural",
    "tts_speed": "+0%",
    "silence_threshold": 500,
    "listen_timeout_seconds": 10
  },

  "screen": {
    "enabled": true,
    "interval_seconds": 30,
    "privacy_filters": [
      "banking",
      "passwords",
      "private_browsing"
    ],
    "save_screenshots": false,
    "max_stored_screenshots": 100
  },

  "modes": {
    "default_mode": "guard",
    "auto_sleep_timeout_minutes": 30,
    "combat_features": ["screen", "voice", "proactive"],
    "guard_features": ["screen", "voice"],
    "sleep_features": []
  },

  "media": {
    "default_image_provider": "pollinations",
    "default_video_provider": "pollinations",
    "gallery_path": "./data/gallery",
    "max_gallery_items": 500
  },

  "focus": {
    "default_duration_minutes": 25,
    "break_duration_minutes": 5,
    "long_break_minutes": 15,
    "sessions_before_long_break": 4,
    "block_notifications": true
  },

  "server": {
    "host": "127.0.0.1",
    "port": 3000,
    "open_browser": true
  },

  "services": {
    "weather_api_key": "",
    "news_api_key": "",
    "spotify_client_id": "",
    "spotify_client_secret": ""
  }
}
